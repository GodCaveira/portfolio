# Copie para .env e troque as senhas. O .env fica fora do git.
POSTGRES_PASSWORD=troque-esta-senha-admin
APP_DB_PASSWORD=troque-esta-senha-app
# condicional (atualização condicional atômica) ou bloqueio (SELECT ... FOR UPDATE)
ESTRATEGIA_ESTOQUE=condicional
# Porta local da API (só em 127.0.0.1)
APP_PORTA=3010
