# Copie para .env e troque as senhas. O .env fica fora do git.
POSTGRES_PASSWORD=troque-esta-senha-admin
APP_DB_PASSWORD=troque-esta-senha-app
# condicional (atualização condicional atômica) ou bloqueio (SELECT ... FOR UPDATE)
ESTRATEGIA_ESTOQUE=condicional
# Porta local da API (só em 127.0.0.1)
APP_PORTA=3010
# Painel: primeiro administrador, criado só se o banco ainda não tiver nenhum. E-mail fictício.
ADMIN_EMAIL=admin@exemplo.test
ADMIN_SENHA=troque-esta-senha-do-painel
# Chave que cifra o segredo TOTP no banco: texto aleatório com 32 caracteres ou mais.
TOTP_CHAVE=troque-esta-chave-por-texto-aleatorio-longo
